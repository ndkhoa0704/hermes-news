# Cổng & địa chỉ lắng nghe
PORT=3130
HOST=127.0.0.1
# Lịch tự cập nhật (cron 5 trường, giờ máy). Để trống để tắt.
REFRESH_CRON=0 */2 * * *
# Hermes CLI
HERMES_BIN=hermes
# Để trống = model mặc định của Hermes; ví dụ: anthropic/claude-sonnet-4
HERMES_MODEL=
HERMES_TIMEOUT_MS=900000
# Số bài tối đa gửi cho Hermes và độ "tươi" của tin
MAX_ARTICLES=140
MAX_AGE_HOURS=24
