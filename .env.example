# Cổng & địa chỉ lắng nghe
PORT=3130
HOST=127.0.0.1
# Lịch tự cập nhật (cron 5 trường, giờ máy). Để trống để tắt.
REFRESH_CRON=30 8 * * *
TZ_CRON=Asia/Ho_Chi_Minh
# false = ẩn nút Cập nhật & chặn POST /api/refresh (nên tắt khi public)
ALLOW_MANUAL_REFRESH=true
# Hermes CLI
HERMES_BIN=hermes
HERMES_MODEL=claude-sonnet-5
HERMES_PROVIDER=anthropic
# Số bài đồ họa kể chuyện mỗi lần chạy & số lượt Hermes song song
VISUAL_COUNT=5
VISUAL_CONCURRENCY=3
HERMES_TIMEOUT_MS=900000
# Số bài tối đa gửi cho Hermes và độ "tươi" của tin
MAX_ARTICLES=140
MAX_AGE_HOURS=24
